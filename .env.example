# ──────────────────────────────────────────────────────────────
# Healthcare Appointment & Follow-up Manager — Environment
# Copy this file to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Free Postgres: https://neon.tech — create a project, copy the pooled
# connection string (Dashboard → Connection Details → Pooled connection).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Redis (required) ─────────────────────────────────────────
# Free Redis: https://upstash.com — create a database, then copy the
# ioredis/Node connection string (NOT the REST URL — it must start with
# redis:// or rediss://, not https://).
REDIS_URL="rediss://default:password@host:6379"

# ── LLM — Groq (required unless using Gemini instead) ─────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=""
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# ── LLM — Gemini [OPTIONAL, alternate provider] ────────────────
# Free key: https://aistudio.google.com/apikey
# If GEMINI_API_KEY is set, the worker uses Gemini instead of Groq
# automatically (see apps/worker/src/llm-client.ts). Force one or the
# other explicitly with LLM_PROVIDER.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"
# LLM_PROVIDER="groq"   # or "gemini"

# ── Auth ─────────────────────────────────────────────────────
# Random secrets — e.g. `openssl rand -hex 32`. Use different values for
# each in production; only shared here because local dev doesn't care.
JWT_ACCESS_SECRET="replace-with-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-string"

# ── Encryption ───────────────────────────────────────────────
# AES-256-GCM key for encrypting Google OAuth tokens at rest — must be
# exactly 32 bytes, hex-encoded (64 hex characters). Generate with
# `openssl rand -hex 32`. Must be the SAME value everywhere the API and
# worker run (the API encrypts, the worker decrypts).
ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"

# ── Email — SMTP [OPTIONAL] ─────────────────────────────────
# Provider-agnostic SMTP. Free options: Resend (resend.com), Brevo,
# or Gmail with an app password. Without a verified sending domain,
# most providers only deliver to the account owner's own address —
# see README's "Known limitations" section.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_FROM="onboarding@resend.dev"

# ── Google Calendar — OAuth 2.0 [OPTIONAL] ───────────────────
# If absent, calendar sync is disabled; bookings still work regardless.
# See README's "Google Calendar setup" section for the full walkthrough
# (Cloud Console project, OAuth consent screen, test users, redirect URI).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/integrations/google/callback"

# ── App URLs ─────────────────────────────────────────────────
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# ── Internal Cron Auth ───────────────────────────────────────
# Shared secret for authenticating /internal/tick calls. Change this —
# it authenticates the endpoint that sweeps expired holds and dispatches
# reminders.
CRON_SECRET="change-me"

# ── Node Environment ─────────────────────────────────────────
NODE_ENV="development"
PORT=4000
