// Healthcare Appointment & Follow-up Manager — Prisma Schema
// Matches solution-architecture.md §3.1 exactly

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────

enum UserRole {
  patient
  doctor
  admin
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  fullName     String   @map("full_name")
  phone        String?
  timezone     String   @default("Asia/Kolkata")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  patient          Patient?
  doctor           Doctor?
  oauthCredentials OauthCredential[]
  calendarLinks    CalendarLink[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

enum Gender {
  male
  female
  other
}

model Patient {
  userId     String   @id @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  dob        DateTime? @db.Date
  gender     Gender?
  bloodGroup String?  @map("blood_group")
  allergies  String[] @default([])

  appointments        Appointment[]
  medicationReminders MedicationReminder[]
  slots               Slot[]               @relation("HeldByPatient")

  @@map("patients")
}

model Doctor {
  userId              String  @id @map("user_id") @db.Uuid
  user                User    @relation(fields: [userId], references: [id])
  specialisationId    String  @map("specialisation_id") @db.Uuid
  specialisation      Specialisation @relation(fields: [specialisationId], references: [id])
  registrationNo      String  @map("registration_no")
  qualification       String
  consultationFee     Int     @default(0) @map("consultation_fee")
  slotDurationMin     Int     @default(30) @map("slot_duration_min")
  bufferMin           Int     @default(0) @map("buffer_min")
  isAcceptingBookings Boolean @default(true) @map("is_accepting_bookings")

  availability DoctorAvailability[]
  leaves       DoctorLeave[]
  slots        Slot[]
  appointments Appointment[]       @relation("DoctorAppointments")
  visitNotes   VisitNote[]

  @@map("doctors")
}

model Specialisation {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  doctors Doctor[]

  @@map("specialisations")
}

// ── Availability ────────────────────────────────────────────

model DoctorAvailability {
  id        String    @id @default(uuid()) @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  doctor    Doctor    @relation(fields: [doctorId], references: [userId])
  weekday   Int       @db.SmallInt // 0=Sun..6=Sat
  startTime String    @map("start_time") // HH:MM format
  endTime   String    @map("end_time")   // HH:MM format
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to")   @db.Date

  @@map("doctor_availability")
}

model DoctorLeave {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  doctor    Doctor   @relation(fields: [doctorId], references: [userId])
  startTs   DateTime @map("start_ts") @db.Timestamptz()
  endTs     DateTime @map("end_ts") @db.Timestamptz()
  reason    String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Note: GiST exclusion constraint for overlapping leaves
  // is added via raw SQL migration since Prisma doesn't support it natively

  @@map("doctor_leaves")
}

// ── The critical table ──────────────────────────────────────

enum SlotStatus {
  available
  held
  booked
  blocked
}

model Slot {
  id             String     @id @default(uuid()) @db.Uuid
  doctorId       String     @map("doctor_id") @db.Uuid
  doctor         Doctor     @relation(fields: [doctorId], references: [userId])
  startTs        DateTime   @map("start_ts") @db.Timestamptz()
  endTs          DateTime   @map("end_ts") @db.Timestamptz()
  status         SlotStatus @default(available)
  holdToken      String?    @map("hold_token") @db.Uuid
  holdExpiresAt  DateTime?  @map("hold_expires_at") @db.Timestamptz()
  heldByPatientId String?   @map("held_by_patient_id") @db.Uuid
  heldByPatient  Patient?   @relation("HeldByPatient", fields: [heldByPatientId], references: [userId])
  version        Int        @default(0)

  // A slot can accumulate more than one appointment over its lifetime
  // (book → cancel → rebook), so this is not unique on the Slot side.
  // Double-booking is still impossible: only one appointment can ever
  // exist while the slot's own status is 'booked', enforced by the
  // atomic status transition in the hold/confirm flow (see §4 of
  // solution-architecture.md), not by a constraint on this relation.
  appointments Appointment[]

  // The double-booking prevention constraint
  @@unique([doctorId, startTs])
  @@index([doctorId, startTs, status])
  @@map("slots")
}

// ── Appointments ────────────────────────────────────────────

enum AppointmentStatus {
  scheduled
  checked_in
  completed
  cancelled_by_patient
  cancelled_by_clinic
  no_show
}

model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  slotId              String            @map("slot_id") @db.Uuid
  slot                Slot              @relation(fields: [slotId], references: [id])
  patientId           String            @map("patient_id") @db.Uuid
  patient             Patient           @relation(fields: [patientId], references: [userId])
  doctorId            String            @map("doctor_id") @db.Uuid
  doctor              Doctor            @relation("DoctorAppointments", fields: [doctorId], references: [userId])
  status              AppointmentStatus @default(scheduled)
  bookedAt            DateTime          @default(now()) @map("booked_at")
  cancelledAt         DateTime?         @map("cancelled_at")
  cancellationReason  String?           @map("cancellation_reason")
  rescheduledFromId   String?           @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom     Appointment?      @relation("RescheduledFrom", fields: [rescheduledFromId], references: [id])
  rescheduledTo       Appointment[]     @relation("RescheduledFrom")
  idempotencyKey      String?           @unique @map("idempotency_key")

  symptomSubmission SymptomSubmission?
  visitNote         VisitNote?
  prescription      Prescription?
  aiSummaries       AiSummary[]
  notifications     Notification[]
  calendarLinks     CalendarLink[]

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([slotId])
  @@map("appointments")
}

model SymptomSubmission {
  id                  String   @id @default(uuid()) @db.Uuid
  appointmentId       String   @unique @map("appointment_id") @db.Uuid
  appointment         Appointment @relation(fields: [appointmentId], references: [id])
  rawSymptoms         String   @map("raw_symptoms")
  durationDays        Int?     @map("duration_days")
  severity            Int?     @map("severity_1_10") @db.SmallInt
  existingConditions  String[] @default([]) @map("existing_conditions")
  currentMedications  String[] @default([]) @map("current_medications")
  additionalNotes     String?  @map("additional_notes")
  submittedAt         DateTime @default(now()) @map("submitted_at")

  @@map("symptom_submissions")
}

model VisitNote {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String   @map("doctor_id") @db.Uuid
  doctor        Doctor   @relation(fields: [doctorId], references: [userId])
  clinicalNotes String   @map("clinical_notes")
  diagnosis     String
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("visit_notes")
}

model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  issuedAt      DateTime @default(now()) @map("issued_at")

  items PrescriptionItem[]

  @@map("prescriptions")
}

enum Frequency {
  OD
  BD
  TDS
  QID
  SOS
  WEEKLY
}

enum MealTiming {
  before_food
  after_food
  any
}

model PrescriptionItem {
  id             String    @id @default(uuid()) @db.Uuid
  prescriptionId String    @map("prescription_id") @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  drugName       String    @map("drug_name")
  strength       String
  doseText       String    @map("dose_text")
  frequency      Frequency
  timing         MealTiming
  durationDays   Int       @map("duration_days")
  instructions   String?

  reminders MedicationReminder[]

  @@map("prescription_items")
}

// ── AI ──────────────────────────────────────────────────────

enum AiSummaryKind {
  pre_visit
  post_visit
}

enum AiSummaryStatus {
  pending
  ready
  failed
  degraded
}

enum Urgency {
  low
  medium
  high
}

model AiSummary {
  id                 String         @id @default(uuid()) @db.Uuid
  appointmentId      String         @map("appointment_id") @db.Uuid
  appointment        Appointment    @relation(fields: [appointmentId], references: [id])
  kind               AiSummaryKind
  status             AiSummaryStatus @default(pending)
  urgency            Urgency?
  chiefComplaint     String?        @map("chief_complaint")
  suggestedQuestions Json?          @map("suggested_questions") @db.JsonB
  patientSummary     String?        @map("patient_summary")
  medicationSchedule Json?          @map("medication_schedule") @db.JsonB
  followUpSteps      Json?          @map("follow_up_steps") @db.JsonB
  model              String?
  promptVersion      String?        @map("prompt_version")
  rawResponse        String?        @map("raw_response")
  inputTokens        Int?           @map("input_tokens")
  outputTokens       Int?           @map("output_tokens")
  latencyMs          Int?           @map("latency_ms")
  attemptCount       Int            @default(0) @map("attempt_count")
  failureReason      String?        @map("failure_reason")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@unique([appointmentId, kind])
  @@map("ai_summaries")
}

// ── Reminders ───────────────────────────────────────────────

enum ReminderStatus {
  pending
  sent
  skipped
  failed
}

model MedicationReminder {
  id                 String         @id @default(uuid()) @db.Uuid
  patientId          String         @map("patient_id") @db.Uuid
  patient            Patient        @relation(fields: [patientId], references: [userId])
  prescriptionItemId String         @map("prescription_item_id") @db.Uuid
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  dueAt              DateTime       @map("due_at") @db.Timestamptz()
  status             ReminderStatus @default(pending)
  sentAt             DateTime?      @map("sent_at") @db.Timestamptz()

  @@index([status, dueAt])
  @@map("medication_reminders")
}

// ── Reliability ─────────────────────────────────────────────

model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json      @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()

  @@index([publishedAt, id])
  @@map("outbox")
}

enum NotificationChannel {
  email
}

enum NotificationStatus {
  queued
  sent
  failed
  dead
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  appointmentId     String?            @map("appointment_id") @db.Uuid
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id])
  recipientUserId   String             @map("recipient_user_id") @db.Uuid
  recipient         User               @relation(fields: [recipientUserId], references: [id])
  channel           NotificationChannel @default(email)
  templateKey       String             @map("template_key")
  dedupeKey         String             @unique @map("dedupe_key")
  payload           Json               @db.JsonB
  status            NotificationStatus @default(queued)
  attemptCount      Int                @default(0) @map("attempt_count")
  lastError         String?            @map("last_error")
  nextRetryAt       DateTime?          @map("next_retry_at") @db.Timestamptz()
  providerMessageId String?            @map("provider_message_id")

  @@index([status, nextRetryAt])
  @@map("notifications")
}

enum CalendarProvider {
  google
}

enum CalendarSyncState {
  pending
  synced
  failed
  deleted
}

model CalendarLink {
  id              String           @id @default(uuid()) @db.Uuid
  appointmentId   String           @map("appointment_id") @db.Uuid
  appointment     Appointment      @relation(fields: [appointmentId], references: [id])
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id])
  provider        CalendarProvider @default(google)
  externalEventId String?          @map("external_event_id")
  calendarId      String?          @map("calendar_id")
  syncState       CalendarSyncState @default(pending) @map("sync_state")
  lastSyncedAt    DateTime?        @map("last_synced_at") @db.Timestamptz()

  @@unique([appointmentId, userId])
  @@map("calendar_links")
}

model OauthCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id])
  provider        String
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String    @map("refresh_token_enc")
  scope           String?
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()

  @@unique([userId, provider])
  @@map("oauth_credentials")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorUserId])
  @@map("audit_log")
}
